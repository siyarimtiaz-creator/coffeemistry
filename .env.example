# Coffeemistry Environment Variables

# Application Port (defaults to 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection (MySQL)
# Optional in standalone mode (built-in in-memory fallback catalog & order management will be used if omitted)
DATABASE_URL=mysql://root:password@localhost:3306/coffeemistry

# Session & Security
JWT_SECRET=coffeemistry-production-secret-change-me-in-production

# Owner & Authentication (Optional)
# Set OWNER_OPEN_ID to the admin user's openId for administrative privileges
OWNER_OPEN_ID=
OAUTH_SERVER_URL=

# Media Storage (Optional)
# Static product assets and hero images are served from client/public/assets
# Remote S3/Forge presigned uploads use these when configured
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
